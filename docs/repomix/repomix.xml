  color: var(--text-secondary);
  max-width: 300px;
}
.eval-table tbody tr:hover,
.eval-table .eval-row-expanded {
  background: var(--bg-elevated);
}
.eval-table .eval-expanded-panel td {
  padding: 0 var(--space-2-5) var(--space-2-5);
}
.eval-expanded-content {
  background: var(--bg-elevated);
  border-radius: var(--radius);
  padding: var(--space-4);
  animation: fade-in var(--transition-fast);
}
.pad-panel-section { padding: var(--space-2-5) 0 var(--space-2); }
.pad-panel-sparse  { padding: var(--space-2-5) 0 var(--space-1); }
.tab-btn,
.period-btn {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
}
.tab-nav {
  display: flex;
  gap: var(--space-1);
  margin-bottom: var(--space-6);
  border-bottom: var(--border-width-thin) solid var(--border);
}
.tab-btn {
  padding: var(--space-2) var(--space-4);
  font-size: var(--font-size-base);
  border-bottom: var(--border-width-thick) solid transparent;
  margin-bottom: -1px;
  transition: color var(--transition-fast), border-color var(--transition-fast);
}
.tab-btn:hover {
  color: var(--text-primary);
}
.tab-btn[aria-selected="true"] {
  color: var(--text-primary);
  border-bottom-color: var(--accent);
}
.period-selector {
  display: inline-flex;
  gap: var(--space-1);
  background: var(--bg-elevated);
  border-radius: var(--radius);
  padding: var(--space-px);
}
.period-btn {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius);
  font-size: var(--font-size-xs);
  font-family: var(--font-body);
}
.period-btn.active {
  background: var(--bg-card);
  color: var(--text-primary);
}
.header {
  justify-content: space-between;
  margin-bottom: var(--space-6);
}
.header-actions {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
}
.logout-btn {
  color: var(--text-secondary);
}
.logout-btn:hover {
  color: var(--text-primary);
}
.logout-btn:disabled {
  opacity: 0.6;
  cursor: default;
}
.header h1 {
  font-size: var(--font-size-xl);
  font-weight: var(--bold);
}
.page-skeleton { height: var(--skeleton-height, 300px); }
.skeleton {
  background: linear-gradient(90deg, var(--bg-card) 25%, var(--bg-elevated) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  border-radius: var(--radius);
}
@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.empty-state {
  text-align: center;
  padding: var(--space-16) var(--space-6);
  color: var(--text-secondary);
}
.empty-state h2 {
  color: var(--text-primary);
  margin-bottom: var(--space-2);
}
.empty-state code {
  background: var(--bg-elevated);
  padding: var(--space-px) var(--space-1-5);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
}
.back-link {
  font-size: var(--font-size-xs);
  gap: var(--space-1);
  margin-bottom: var(--space-4);
}
.error-state {
  background: var(--bg-status-critical);
  border: var(--border-width-thin) solid var(--border-status-critical);
  border-radius: var(--radius);
  padding: var(--space-6);
  text-align: center;
}
.error-state h2 {
  color: var(--status-critical);
  margin-bottom: var(--space-2);
}
.error-state .error-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
  justify-content: center;
}
.error-state .error-actions button,
.error-state .error-actions a {
  padding: var(--space-1-5) var(--space-4);
  cursor: pointer;
}
.section-heading {
  font-size: var(--font-size-md);
  font-weight: var(--bold);
  margin-bottom: var(--space-4);
  margin-top: var(--space-8);
}
.ls-id { letter-spacing: var(--letter-spacing-id); }
.issue-callout {
  border-left: var(--border-width-rail) solid var(--s-fg);
  background: var(--s-bg);
  border-radius: 0 var(--radius) var(--radius) 0;
  padding: var(--space-2-5) var(--space-3-5);
}
.issue-callout .callout-title { color: var(--s-fg); }
.page-content { max-width: var(--page-content-max-width); }
.centered-callout {
  max-width: var(--callout-max-width, 480px);
  margin: 0 auto;
}
.card-spacious {
  padding: var(--space-8) var(--space-6);
}
.stat-label-section {
  letter-spacing: var(--label-letter-spacing-wide);
  margin: var(--space-3-5) 0 var(--space-2);
}
.commit-summary {
  padding: var(--space-2) var(--space-1);
}
.commit-detail {
  padding-left: var(--space-5);
  padding-bottom: var(--space-2-5);
}
.commit-body {
  font-family: var(--font-body);
}
.agent-stat-card {
  background: var(--bg-elevated);
  border: var(--border-width-thin) solid var(--border-subtle);
  border-radius: var(--radius);
  padding: var(--space-2-5) var(--space-3-5);
}
.agent-stat-card[data-has-error='true'] {
  border-color: var(--status-warning);
}
.session-detail-header {
  background: var(--bg-card);
  border: var(--border-width-thin) solid var(--border-subtle);
  border-bottom: none;
  padding: var(--space-5) var(--space-6) var(--space-4);
  margin-bottom: 0;
}
.session-vitals-strip {
  background: var(--bg-elevated);
  border: var(--border-width-thin) solid var(--border-subtle);
  border-bottom: var(--border-width-thin) solid var(--border);
  padding: var(--space-3-5) var(--space-6);
  row-gap: var(--space-3);
  margin-bottom: var(--space-0-5);
}
.stat-item {
  flex: 1 1 100px;
  min-width: 80px;
  text-align: center;
}
.stat-value {
  font-size: var(--font-size-stat);
  line-height: 1.1;
}
.stat-label {
  font-size: var(--font-size-xs);
  font-family: var(--font-mono);
  color: var(--text-muted);
  letter-spacing: var(--stat-label-letter-spacing);
  margin-top: var(--space-px);
}
.freq-bar-row {
  display: grid;
  grid-template-columns: 160px 1fr 36px;
  align-items: center;
  gap: var(--space-2-5);
  margin-bottom: var(--space-1-5);
}
.vitals-divider {
  width: 1px;
  background: var(--border-subtle);
  margin: 0 var(--space-2);
  align-self: stretch;
}
.freq-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 0 var(--space-8);
}
.view-section {
  margin-bottom: var(--space-8);
}
.refetch-indicator {
  position: fixed;
  top: var(--space-4);
  right: var(--space-4);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius);
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  z-index: 1000;
  animation: fade-in var(--transition-fast);
}
@keyframes fade-in {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes toxicPulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--critical-alpha-40); }
  50% { box-shadow: 0 0 6px 2px var(--critical-alpha-60); }
}
.score-badge-wrapper {
  position: relative;
  cursor: default;
}
.score-no-data { color: var(--status-no-data); }
.score-badge-tooltip {
  bottom: calc(100% + var(--space-2));
  border-radius: var(--radius);
  padding: var(--space-2-5) var(--space-3);
  min-width: 200px;
  max-width: 300px;
  z-index: 20;
  white-space: normal;
  animation: fade-in var(--transition-fast);
}
.score-badge-wrapper:hover .score-badge-tooltip,
.score-badge-wrapper:focus-within .score-badge-tooltip {
  display: block;
}
.tooltip-row {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-px) 0;
  color: var(--text-primary);
}
.tooltip-row--col { flex-direction: column; }
.tooltip-link {
  display: block;
  margin-top: var(--space-2);
  padding-top: var(--space-1-5);
  border-top: var(--border-width-thin) solid var(--border);
}
.cot-panel {
  margin-top: var(--space-1);
}
.cot-summary {
  color: var(--text-secondary);
  cursor: pointer;
  padding: var(--space-1) 0;
  list-style: none;
}
.cot-summary::-webkit-details-marker {
  display: none;
}
.cot-summary::before {
  content: '\25B6';
  display: inline-block;
  margin-right: var(--space-1-5);
  font-size: var(--font-size-2xs);
  transition: transform var(--transition-fast);
}
details[open] > .cot-summary::before {
  transform: rotate(90deg);
}
.cot-content {
  font-size: var(--font-size-xs);
  color: var(--text-primary);
  line-height: 1.6;
  padding: var(--space-2) 0 var(--space-1);
}
.eval-detail-header {
  margin-bottom: var(--space-6);
}
.eval-detail-meta {
  gap: var(--space-4);
  margin-top: var(--space-2);
}
.eval-detail-card {
  margin-bottom: var(--space-4);
}
.eval-overlay-card {
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius);
}
.eval-summary-card {
  cursor: pointer;
  transition: border-color var(--transition-fast);
}
.eval-summary-card.card:hover {
  border-color: var(--accent);
}
.link-plain {
  text-decoration: none;
  color: inherit;
}
.span-row {
  padding-top: var(--space-2);
  padding-bottom: var(--space-2);
  padding-left: var(--span-row-indent, 0);
}
.span-status-icon { color: var(--text-primary); }
.span-status-icon[data-error] { color: var(--status-critical); }
.span-bar {
  height: var(--space-1);
  width: var(--span-bar-width);
  min-width: var(--span-bar-min-width, 0);
  background: var(--status-healthy);
  border-radius: var(--radius-xs);
  margin-top: var(--space-1);
}
.span-bar[data-error] { background: var(--status-critical); }
.quality-live-bar {
  flex-wrap: wrap;
  padding: var(--space-1-5) var(--space-3);
  border-radius: var(--radius);
}
.quality-chip {
  background: color-mix(in srgb, var(--chip-color) var(--chip-tint), transparent);
  color: var(--chip-color);
}
.quality-chip .dot-xs { background: var(--chip-color); }
.cqi-value {
  font-size: var(--font-size-3xl);
  line-height: 1.2;
  color: var(--cqi-color, var(--text-primary));
}
.cqi-segment { min-width: var(--space-0-5); flex: var(--cqi-segment-flex); background-color: var(--cqi-segment-bg); }
.cqi-segment-bar {
  height: var(--space-2);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.heatmap-grid { display: grid; aspect-ratio: var(--heatmap-aspect); grid-template-columns: var(--heatmap-grid-cols); grid-template-rows: var(--heatmap-grid-rows); }
.heatmap-row-header {
  justify-content: flex-end;
  padding-right: var(--space-2);
}
.heatmap-cell {
  border-radius: var(--radius-xs);
  min-height: 36px;
  border: none;
  background-color: var(--heatmap-cell-bg);
  color: var(--heatmap-cell-fg);
}
.heatmap-cell[data-toxic] {
  border: var(--border-width-thick) solid var(--score-failing);
  animation: toxicPulse 2s ease-in-out infinite;
}
.metric-card-compact {
  background: var(--bg-card);
  border: var(--border-width-thin) solid var(--border-subtle);
  border-radius: var(--radius);
  padding: var(--space-2) var(--space-2-5);
  min-width: 140px;
}
.agent-activity-table {
  min-width: 640px;
}
.agent-inv-bar {
  min-width: 48px;
}
.agent-inv-count { min-width: var(--space-8); }
.agent-dot { background: var(--agent-color, var(--border)); }
.agent-err-rate { color: var(--status-critical); }
.agent-err-rate[data-err-status="ok"] { color: var(--status-healthy); }
.agent-err-rate[data-err-status="warn"] { color: var(--status-warning); }
.score-band { color: var(--band-fg); }
.grid-two-col,
.agent-expanded-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.score-label-width {
  min-width: var(--space-8);
}
.agent-expanded-grid {
  gap: var(--space-4);
  padding: var(--space-3) 0 var(--space-1);
}
.alert-compound {
  border-left-width: var(--space-1);
  background: var(--bg-elevated);
}
.alert-related {
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}
.alert-metric-link {
  font-family: var(--font-mono);
  padding: var(--space-px) var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--accent-alpha-10);
}
.alert-metric-link:hover {
  background: var(--accent-alpha-20);
}
.remediation-list {
  margin-top: var(--space-2);
  padding-left: var(--space-5);
  color: var(--accent);
}
.remediation-list li {
  margin-bottom: var(--space-1);
}
.threshold-bar {
  position: relative;
  height: var(--space-1-5);
  background: var(--bg-card);
  border-radius: var(--radius-bar);
  margin-top: var(--space-2);
  overflow: visible;
}
.threshold-bar-fill,
.variance-bar-fill {
  height: 100%;
  transition: var(--transition-bar);
}
.threshold-bar-fill { width: var(--bar-fill-width); border-radius: var(--radius-bar); background: var(--status-healthy); }
.threshold-bar-fill[data-violating] { background: var(--status-critical); }
.variance-bar-fill  { border-radius: var(--radius-xs); }
.threshold-bar-marker {
  position: absolute;
  top: -3px;
  left: var(--bar-marker-left);
  width: 2px;
  height: 12px;
  background: var(--text-primary);
  border-radius: calc(var(--radius-xs) / 2);
  transform: translateX(-1px);
}
.pipeline-stat {
  gap: var(--space-1);
}
.pipeline-stat .stat-value {
  font-family: var(--font-mono);
  color: var(--text-primary);
  font-weight: var(--light-bold);
}
.funnel-bar {
  width: var(--funnel-width);
  background: var(--funnel-bg, var(--accent));
  border-radius: var(--radius-sm);
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-2-5);
  transition: var(--transition-bar);
  min-width: 40px;
  height: 32px;
}
.funnel-dropoff {
  padding-left: var(--space-2-5);
  margin: var(--space-0-5) 0;
  color: var(--text-secondary);
}
.funnel-dropoff[data-warn] {
  color: var(--status-warning);
}
.metric-worst {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  margin-top: var(--space-2);
  line-height: 1.4;
}
.metric-worst .worst-score {
  color: var(--score-failing);
  font-family: var(--font-mono);
  font-weight: var(--light-bold);
}
.provenance-grid,
.agreement-grid,
.confidence-stats-grid {
  display: grid;
  gap: var(--space-1) var(--space-4);
}
.provenance-grid,
.agreement-grid {
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
}
.provenance-grid,
.confidence-stats-grid { grid-template-columns: auto 1fr; }
.agreement-grid { grid-template-columns: 1fr auto auto; }
.provenance-grid .prov-label {
  color: var(--text-secondary);
  font-family: var(--font-body);
  white-space: nowrap;
}
.provenance-grid .prov-value {
  color: var(--text-primary);
  word-break: break-all;
}
.provenance-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}
.provenance-actions button {
  background: var(--bg-surface);
  border: var(--border-width-thin) solid var(--border);
  color: var(--accent);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: var(--font-body);
}
.provenance-actions button:hover {
  background: var(--bg-hover);
  border-color: var(--border-accent);
}
.confidence-header {
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}
.confidence-level-indicator { color: var(--score-failing); }
.confidence-level-indicator[data-level="high"] { color: var(--score-excellent); }
.confidence-level-indicator[data-level="medium"] { color: var(--score-adequate); }
.agreement-value { color: var(--band-fg, var(--score-failing)); }
.confidence-method {
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
  color: var(--text-muted);
}
.agreement-grid .ag-header {
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  font-family: var(--font-body);
  padding-bottom: var(--space-1);
  border-bottom: var(--border-width-thin) solid var(--border-subtle);
}
.agreement-summary .summary-value {
  font-family: var(--font-mono);
  color: var(--text-primary);
}
.variance-bar {
  gap: var(--space-2);
}
.bar-track,
.variance-bar-track,
.mini-bar {
  height: var(--bar-h, var(--space-1));
  background: var(--bar-track-color, var(--bg-surface));
  border-radius: var(--radius-xs);
}
.variance-bar-track,
.mini-bar { overflow: hidden; }
.variance-bar-track { flex: 1; }
.mini-bar-fill {
  height: 100%;
  width: var(--bar-fill-width);
  background: var(--bar-fill-color, var(--accent));
  opacity: var(--bar-fill-opacity, 1);
  border-radius: var(--radius-xs);
  transition: var(--transition-bar);
}
.card--empty {
  padding: var(--space-4);
  color: var(--text-muted);
}
