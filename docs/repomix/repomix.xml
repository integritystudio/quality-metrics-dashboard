  const rl = createInterface({
    input: stream,
    crlfDelay: Infinity,
  });
  for await (const line of rl) {
    if (!line.trim()) continue;
    try {
      const parsed = JSON.parse(line) as unknown;
      const result = schema.safeParse(parsed);
      if (result.success) {
        yield result.data;
      }
    } catch {
    }
  }
}
