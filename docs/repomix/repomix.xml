  const bucketMap = rollup(
    valid,
    evals => mean(evals, ev => ev.scoreValue as number) ?? null,
    ev => Math.min(Math.floor((Number(ev.timestamp) / NANOS_TO_MS - startMs) / bucketWidth), buckets - 1),
